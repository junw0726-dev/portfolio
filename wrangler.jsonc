{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/site-content.js", "/admin", "/admin/", "/admin.html", "/login", "/login.html"]
  },
  "r2_buckets": [{"binding": "PORTFOLIO_STORE", "bucket_name": "portfolio-content"}],
  "ratelimits": [{"name": "LOGIN_LIMITER", "namespace_id": "2026103001", "simple": {"limit": 10, "period": 60}}]
}
